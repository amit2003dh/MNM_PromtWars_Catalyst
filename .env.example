# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/carenest?retryWrites=true&w=majority
MONGODB_DB=carenest

# Gmail SMTP Passwordless OTP Configuration
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Resend Email Configuration
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# Next.js App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scheduler Secret (for protected escalation / reminder endpoints)
CRON_SECRET=carenest-secret-cron-token-2026
